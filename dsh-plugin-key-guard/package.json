{
  "name": "@zhuyeqi/dsh-plugin-key-guard",
  "version": "0.5.0",
  "private": true,
  "description": "Key security for DeepSeek Harness: masks AI/LLM API keys in outbound model context and restores placeholders in model replies, so real keys never leave this machine",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./engine": "./engine.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./egress": "./egress.js",
    "./boundaries": "./boundaries.js"
  },
  "files": [
    "index.js",
    "engine.js",
    "egress.js",
    "boundaries.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
